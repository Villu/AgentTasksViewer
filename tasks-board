#!/usr/bin/env bash
# tasks-board — render a markdown task file as a self-contained HTML board.
#
# The output is generated and never authoritative: the markdown file is the only
# source of truth, and this is a view of it that can be deleted and regenerated
# at any time. That is deliberate. A tracker with its own database becomes a
# second source of truth, and then the two disagree and nobody can say which is
# right. Gitignore the output, and the .stamp written beside it.
#
# Usage:
#   tasks-board [options]
#     --file PATH       task file to read      (default: ./TASKS.md, or $TASKS_FILE)
#     --out PATH        html to write          (default: ./tasks-board.html)
#     --title TEXT      heading on the page    (default: the directory name)
#     --label TEXT      how the footer says to invoke this (default: tasks-board)
#     --ref REF         read the file from a git ref instead of the working copy,
#                       e.g. --ref origin/main. --file is then a repo-relative
#                       path. A remote ref is fetched before each check.
#     --closed [N]      add a section listing tasks finished by deleting their
#                       block, read from the git log rather than from the file
#                       (default: the 20 most recent). Off unless asked for.
#     --closed-match P  the commit-subject prefix that marks a finish
#                       (default: "Close "). Implies --closed.
#     --watch [SECONDS] re-render whenever the source changes (default: 5)
#     --serve [PORT]    --watch, and serve the board over http so it can actually
#                       refresh itself (default: 8787). Needs python3.
#
# --closed exists because deleting a task's whole block is the recommended way to
# finish one, which leaves a queue of only live work and nothing to look back at.
# Those finishes are already recorded: each is a commit touching the task file.
# The section is opt-in rather than on by default, because the commit convention
# belongs to the repository and not to this tool — a board that assumed a prefix
# would show an empty section to everyone who spells it differently, with nothing
# to say why. Asking for it is what makes the default meaningful.
#
# It is a view of the log and says so: it reports how many it is showing out of
# how many it found, and when the log cannot be read it leaves the section in
# place with the reason rather than failing the render or quietly omitting it.
#
# Prefer --serve. A board opened as a file:// URL cannot fetch the stamp beside
# it, so it cannot tell whether it is still current: it will say so on the page
# rather than claim to be live, but it will not update. Over http it re-checks
# every interval and reloads itself when the source changes.
#
# **Use --ref when more than one machine writes the queue.** Without it the board
# renders your working copy, so a claim someone else pushed is invisible until
# you pull — and the page cannot tell: it correctly reports that it matches the
# render it was given, while the render is of a stale file. `--ref origin/main`
# makes the board track what the fleet actually sees, and the page then names the
# ref it is rendering so nobody mistakes it for their own checkout.
#
# Change detection is the source's mtime for a working copy, and the blob sha for
# a ref — both cheap, and neither needs a filesystem watcher, so this behaves the
# same in bash, Git Bash, WSL and over ssh.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
AWK="$HERE/tasks-board.awk"
FILE="${TASKS_FILE:-TASKS.md}"
OUT="tasks-board.html"
TITLE=""
LABEL="tasks-board"
REF=""
WATCH=0
SERVE=0
EVERY=5
PORT=8787
CLOSED=0
CLOSED_N=20
CLOSED_MATCH="Close "

while [ $# -gt 0 ]; do
  case "$1" in
    --file)  FILE="${2:?--file needs a path}"; shift 2 ;;
    --out)   OUT="${2:?--out needs a path}"; shift 2 ;;
    --title) TITLE="${2:?--title needs text}"; shift 2 ;;
    --label) LABEL="${2:?--label needs text}"; shift 2 ;;
    --ref)   REF="${2:?--ref needs a git ref}"; shift 2 ;;
    --closed) CLOSED=1
             case "${2:-}" in ''|--*) shift ;; *) CLOSED_N="$2"; shift 2 ;; esac ;;
    --closed-match) CLOSED_MATCH="${2:?--closed-match needs a prefix}"; CLOSED=1; shift 2 ;;
    --watch) WATCH=1
             case "${2:-}" in ''|--*) shift ;; *) EVERY="$2"; shift 2 ;; esac ;;
    --serve) WATCH=1; SERVE=1
             case "${2:-}" in ''|--*) shift ;; *) PORT="$2"; shift 2 ;; esac ;;
    -h|--help) sed -n '2,/^[^#]/p' "$0" | sed '$d;s/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

[ -f "$AWK" ] || { echo "tasks-board.awk not found beside $0" >&2; exit 1; }

# One cleanup for every temp this makes, installed once. Two traps each removing
# their own file is how one of them ends up outliving a --serve that was ctrl-c'd.
cleanup() {
  [ -z "${TMP:-}" ]         || rm -f "$TMP"
  [ -z "${CLOSED_FILE:-}" ] || rm -f "$CLOSED_FILE" "$CLOSED_FILE.all"
}
trap cleanup EXIT

TMP=""
if [ -n "$REF" ]; then
  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "--ref needs to run inside a git repository" >&2; exit 1; }
  git rev-parse --verify --quiet "$REF" >/dev/null || {
    echo "no such git ref: $REF" >&2; exit 1; }
  git cat-file -e "$REF:$FILE" 2>/dev/null || {
    echo "$REF has no file at $FILE (--file is repo-relative when --ref is used)" >&2
    exit 1; }
  SOURCE="$REF:$FILE"
  TMP="$(mktemp)"
  [ -n "$TITLE" ] || TITLE="$(basename "$(git rev-parse --show-toplevel)")"
else
  [ -f "$FILE" ] || { echo "no task file at $FILE" >&2; exit 1; }
  SOURCE="the task file"
  [ -n "$TITLE" ] || TITLE="$(basename "$(cd "$(dirname "$FILE")" && pwd)")"
fi

STAMP="$OUT.stamp"

# A remote ref is only as current as the last fetch, so fetch before reading it.
# Failures are ignored on purpose: a board that stops updating because the network
# blinked is worse than one showing the last ref it could reach, and the page says
# which ref it is rendering either way.
refresh_ref() {
  [ -n "$REF" ] || return 0
  case "$REF" in
    */*) git fetch -q "${REF%%/*}" "${REF#*/}" 2>/dev/null || true ;;
  esac
}

# What the render was made from: an mtime for a working copy, a blob sha for a
# ref. Either way it changes exactly when the content does.
version() {
  if [ -n "$REF" ]; then
    git rev-parse "$REF:$FILE" 2>/dev/null || echo none
  else
    stat -c %Y "$FILE" 2>/dev/null \
      || stat -f %m "$FILE" 2>/dev/null \
      || ls -l --time-style=+%s "$FILE" 2>/dev/null | awk '{print $6}'
  fi
}

# Finishes read out of the log, for --closed. Everything here fails soft: a
# shallow clone, a --file outside a repository or a git that refuses for any
# reason leaves the section saying why, because a section that cannot be built is
# not a reason to lose the queue above it. Recollected on every render, so a watch
# picks up new closes — a close commit touches the task file, which is what the
# watch is already keyed on.
CLOSED_TOTAL=0
CLOSED_SHOWN=0
CLOSED_WHY=""
CLOSED_FILE=""
if [ "$CLOSED" = "1" ]; then CLOSED_FILE="$(mktemp)"; fi

collect_closed() {
  [ "$CLOSED" = "1" ] || return 0
  CLOSED_TOTAL=0; CLOSED_SHOWN=0; CLOSED_WHY=""
  : > "$CLOSED_FILE"

  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    CLOSED_WHY="not inside a git repository"; return 0
  fi

  local rev raw
  if [ -n "$REF" ]; then rev="$REF"; else rev="HEAD"; fi
  if ! git rev-parse --verify --quiet "$rev" >/dev/null; then
    CLOSED_WHY="$rev does not resolve, so there is no history to read"; return 0
  fi

  # -F so the prefix is matched literally: it is user-supplied, and a regex
  # metacharacter in somebody's convention should not become a silent filter.
  # --grep only narrows — it matches anywhere in the message, so the prefix is
  # then checked against the subject itself below.
  if ! raw="$(git log "$rev" -F --grep="$CLOSED_MATCH" \
                --format='%h%x09%cs%x09%s' -- "$FILE" 2>/dev/null)"; then
    CLOSED_WHY="git log could not read the history of $FILE"; return 0
  fi

  printf '%s\n' "$raw" \
    | awk -v pre="$CLOSED_MATCH" 'index($0, "\t") > 0 {
        s = $0
        p = index(s, "\t"); s = substr(s, p + 1)
        p = index(s, "\t"); subj = substr(s, p + 1)
        if (index(subj, pre) == 1) print
      }' > "$CLOSED_FILE.all"

  CLOSED_TOTAL="$(awk 'END {print NR + 0}' "$CLOSED_FILE.all")"
  head -n "$CLOSED_N" "$CLOSED_FILE.all" > "$CLOSED_FILE"
  CLOSED_SHOWN="$(awk 'END {print NR + 0}' "$CLOSED_FILE")"
  rm -f "$CLOSED_FILE.all"
}

render() {
  # `local ts`, not `now`: the watch loop below keeps the source's version in
  # `now`, and a global assignment here would land this epoch in `last` after a
  # render, so every later interval compares a version against an epoch and
  # re-renders forever. It only misfires after the first real change, which is why
  # a quiet watch looks correct.
  # One epoch for both the page and the stamp. If the stamp were even a second
  # newer than the number baked into the page, every page would read itself as
  # superseded and reload forever.
  local ts src
  ts="$(date -u +%s)"
  if [ -n "$REF" ]; then git show "$REF:$FILE" > "$TMP"; src="$TMP"; else src="$FILE"; fi
  collect_closed
  awk -v generated="$(date -u '+%Y-%m-%d %H:%M:%S UTC')" \
      -v heading="$TITLE" \
      -v label="$LABEL" \
      -v source="$SOURCE" \
      -v refresh="$1" \
      -v epoch="$ts" \
      -v stamp="$(basename "$STAMP")" \
      -v closed_on="$CLOSED" \
      -v closed_file="$CLOSED_FILE" \
      -v closed_match="$CLOSED_MATCH" \
      -v closed_total="$CLOSED_TOTAL" \
      -v closed_shown="$CLOSED_SHOWN" \
      -v closed_why="$CLOSED_WHY" \
      -f "$AWK" "$src" > "$OUT"
  printf '%s\n' "$ts" > "$STAMP"
}

python_cmd() {
  # Not `command -v python`: on Windows that finds the Microsoft Store stub,
  # which prints an install message and exits 49 without being python at all.
  # Ask each candidate to run something, and believe only the one that does.
  for c in python3 py python; do
    if "$c" -c 'import sys; sys.exit(0)' >/dev/null 2>&1; then echo "$c"; return 0; fi
  done
  return 1
}

refresh_ref
if [ "$WATCH" = "0" ]; then
  render 0
  echo "wrote $OUT from $SOURCE"
  echo "it is a snapshot and says so on the page; --serve keeps one current"
  exit 0
fi

render "$EVERY"

if [ "$SERVE" = "1" ]; then
  if PY="$(python_cmd)"; then
    DIR="$(cd "$(dirname "$OUT")" && pwd)"
    "$PY" -m http.server "$PORT" --bind 127.0.0.1 --directory "$DIR" >/dev/null 2>&1 &
    SRV=$!
    trap 'kill "$SRV" 2>/dev/null || true; cleanup' EXIT INT TERM
    echo "open http://127.0.0.1:$PORT/$(basename "$OUT")"
  else
    SERVE=0
    echo "no working python3 found, so not serving" >&2
    echo "opened over file:// the board will say it cannot verify itself" >&2
  fi
fi

[ "$SERVE" = "1" ] || echo "open $OUT — over file:// it will tell you it cannot refresh"
echo "watching $SOURCE — ctrl-c to stop"
last="$(version)"
while true; do
  sleep "$EVERY"
  refresh_ref
  now="$(version)"
  if [ "$now" != "$last" ]; then
    render "$EVERY"
    echo "$(date -u '+%H:%M:%S') re-rendered"
    last="$now"
  fi
done
